# Python
__pycache__/
*.py[cod]
*.pyd
*.so

# Ambientes virtuais
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Testes e ferramentas
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/

# Sistema operacional
.DS_Store
Thumbs.db

# Dados
data/raw/*
data/interim/*
data/processed/*

!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Modelos treinados
artifacts/models/*
!artifacts/models/.gitkeep

# Métricas e artefatos gerados
artifacts/metrics/*
!artifacts/metrics/.gitkeep

# Referências visuais locais
assets/presentation/*
!assets/presentation/.gitkeep

# Arquivos finais de apresentação
presentation/*.pptx
presentation/*.pdf

# Arquivos temporários
*.tmp
*.log
~$*
